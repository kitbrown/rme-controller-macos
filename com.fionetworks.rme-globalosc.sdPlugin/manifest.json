{
  "$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
  "UUID": "com.fionetworks.rme-globalosc",
  "Name": "RME Controller for macOS",
  "Version": "1.1.8.1",
  "Author": "FiO Networks",
  "Description": "Bidirectional Stream Deck control for RME TotalMix FX using Global OSC.",
  "Icon": "imgs/plugin",
  "Category": "RME Controller for macOS",
  "CategoryIcon": "imgs/category",
  "CodePath": "bin/plugin.js",
  "SDKVersion": 3,
  "Software": {
    "MinimumVersion": "7.1"
  },
  "Nodejs": {
    "Version": "24"
  },
  "OS": [
    {
      "Platform": "mac",
      "MinimumVersion": "13"
    }
  ],
  "Actions": [
    {
      "UUID": "com.fionetworks.rme-globalosc.outputvolume",
      "Name": "Output Volume",
      "Tooltip": "Control a TotalMix hardware output volume; press dial to mute.",
      "Icon": "imgs/action-output",
      "Controllers": [
        "Encoder"
      ],
      "Encoder": {
        "layout": "$B1",
        "TriggerDescription": {
          "Rotate": "Adjust volume",
          "Push": "Mute / unmute"
        }
      },
      "States": [
        {
          "Image": "imgs/dial"
        }
      ],
      "PropertyInspectorPath": "ui/output-volume.html"
    },
    {
      "UUID": "com.fionetworks.rme-globalosc.mixfader",
      "Name": "Submix Fader",
      "Tooltip": "Control a source-to-output TotalMix submix fader.",
      "Icon": "imgs/action-mix",
      "Controllers": [
        "Encoder"
      ],
      "Encoder": {
        "layout": "$B1",
        "TriggerDescription": {
          "Rotate": "Adjust send level",
          "Push": "Mute / unmute"
        }
      },
      "States": [
        {
          "Image": "imgs/dial"
        }
      ],
      "PropertyInspectorPath": "ui/mix-fader.html"
    },
    {
      "UUID": "com.fionetworks.rme-globalosc.toggle",
      "Name": "Control Toggle",
      "Tooltip": "Control a documented TotalMix Global OSC boolean path.",
      "Icon": "imgs/action-toggle",
      "Controllers": [
        "Keypad"
      ],
      "DisableAutomaticStates": true,
      "States": [
        {
          "Image": "imgs/toggle",
          "Title": "OFF"
        },
        {
          "Image": "imgs/toggle-on",
          "Title": "ON"
        }
      ],
      "PropertyInspectorPath": "ui/toggle.html"
    },
    {
      "UUID": "com.fionetworks.rme-globalosc.snapshot",
      "Name": "Snapshot",
      "Tooltip": "Recall a TotalMix snapshot.",
      "Icon": "imgs/action-snapshot",
      "Controllers": [
        "Keypad"
      ],
      "DisableAutomaticStates": true,
      "States": [
        {
          "Image": "imgs/snapshot",
          "Title": "SNAP"
        },
        {
          "Image": "imgs/snapshot-on",
          "Title": "ACTIVE"
        }
      ],
      "PropertyInspectorPath": "ui/snapshot.html"
    }
  ],
  "Profiles": [
    {
      "Name": "profiles/rme-starter-stream-deck",
      "DeviceType": 0,
      "AutoInstall": true,
      "DontAutoSwitchWhenInstalled": true,
      "Readonly": false
    },
    {
      "Name": "profiles/rme-starter-mini",
      "DeviceType": 1,
      "AutoInstall": true,
      "DontAutoSwitchWhenInstalled": true,
      "Readonly": false
    },
    {
      "Name": "profiles/rme-starter-xl",
      "DeviceType": 2,
      "AutoInstall": true,
      "DontAutoSwitchWhenInstalled": true,
      "Readonly": false
    },
    {
      "Name": "profiles/rme-starter-plus",
      "DeviceType": 7,
      "AutoInstall": true,
      "DontAutoSwitchWhenInstalled": true,
      "Readonly": false
    },
    {
      "Name": "profiles/rme-starter-neo",
      "DeviceType": 9,
      "AutoInstall": true,
      "DontAutoSwitchWhenInstalled": true,
      "Readonly": false
    },
    {
      "Name": "profiles/rme-starter-plus-xl",
      "DeviceType": 13,
      "AutoInstall": true,
      "DontAutoSwitchWhenInstalled": true,
      "Readonly": false
    }
  ]
}
