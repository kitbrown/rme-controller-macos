  "license": "MIT",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w --watch.onEnd=\"streamdeck restart com.chris.rme-globalosc\"",
    "validate": "streamdeck validate com.chris.rme-globalosc.sdPlugin",
    "pack": "streamdeck pack com.chris.rme-globalosc.sdPlugin"
